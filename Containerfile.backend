# Multi-stage build for any of the Go services.
#
#   podman build -f Containerfile.backend --build-arg SERVICE=pim -t doclink/pim:dev .
#
# One file for all four because they differ only in main package: the shared
# contracts and the shared plumbing are the point of the repo, and giving each
# service a near-identical Containerfile would be four places to forget to
# update.
FROM docker.io/library/golang:1.26-alpine AS build

ARG SERVICE
ARG TARGETARCH=arm64

WORKDIR /src

# Dependencies first, so a code change does not re-download the module graph.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY gen ./gen
COPY internal ./internal
COPY services ./services
COPY cmd ./cmd

# CGO off for a static binary that runs on the distroless-style base below.
# Cache mounts, so rebuilding one service after a one-line change does not
# recompile the standard library and the module graph from scratch.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    test -n "$SERVICE" || (echo "SERVICE build-arg is required" && exit 1) && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/app ./${SERVICE}

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
USER nonroot:nonroot
ENTRYPOINT ["/app"]
