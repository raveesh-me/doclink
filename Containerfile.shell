# The PIM shell: its static build plus the small server that attaches the CSP.
#
# Separate from Containerfile.frontend because the shell is the only frontend
# that frames anything, so it is the only one that needs a dynamic frame-src and
# therefore something other than plain nginx. The two embeds stay on nginx.
FROM docker.io/library/node:24-alpine AS web

WORKDIR /src
COPY web/package.json web/package-lock.json* ./
COPY web/gen/package.json ./gen/
COPY web/host-sdk/package.json ./host-sdk/
COPY web/pim-web/package.json ./pim-web/
COPY web/subscriptions-web/package.json ./subscriptions-web/
COPY web/shipping-web/package.json ./shipping-web/
RUN npm install --no-audit --no-fund

COPY web/ ./
RUN npm run build --workspace @doclink/pim-web

FROM docker.io/library/golang:1.26-alpine AS build

ARG TARGETARCH=arm64
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY gen ./gen
COPY internal ./internal
COPY services ./services

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/webhost ./services/webhost

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/webhost /webhost
COPY --from=web /src/pim-web/dist /srv
ENV STATIC_DIR=/srv
USER nonroot:nonroot
ENTRYPOINT ["/webhost"]
