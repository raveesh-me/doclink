# Multi-stage build for any of the three frontends.
#
#   podman build -f Containerfile.frontend --build-arg APP=pim-web -t doclink/pim-web:dev .
#
# The npm workspace is copied whole because the apps share the generated
# protobuf code and the host SDK; those are the contract, and vendoring them per
# app would let the two sides drift.
FROM docker.io/library/node:24-alpine AS build

ARG APP
WORKDIR /src

COPY web/package.json web/package-lock.json* ./
COPY web/gen/package.json ./gen/
COPY web/host-sdk/package.json ./host-sdk/
COPY web/pim-web/package.json ./pim-web/
COPY web/subscriptions-web/package.json ./subscriptions-web/
COPY web/shipping-web/package.json ./shipping-web/
RUN npm install --no-audit --no-fund && npm install-scripts approve esbuild || true

COPY web/ ./
RUN test -n "$APP" || (echo "APP build-arg is required" && exit 1) && \
    npm run build --workspace "@doclink/${APP}"

FROM docker.io/library/nginx:1.27-alpine
ARG APP
COPY --from=build /src/${APP}/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
